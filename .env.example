# Database connection. Default (unset) = local SQLite file, zero setup:
#DATABASE_URL=sqlite+aiosqlite:///./tzlvt.db

# Switching to Postgres is only a connection-string change:
#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tzlvt

# --- Google Sheets sync (optional; app runs fine without it) ---------------
# Auth is a SERVICE ACCOUNT (an API key cannot write). Create one in Google
# Cloud Console (enable the Sheets API), download its JSON key, and share the
# spreadsheet with the service account's client_email as Editor.
#SHEETS_ENABLED=true
#GOOGLE_SHEET_ID=your-spreadsheet-id-from-its-url
#GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# --- Telegram Mini App auth (optional; keep off for plain browser use) ------
# Required once the app is on a public HTTPS URL, so only you can hit the API.
#TELEGRAM_AUTH_ENABLED=true
#TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather
#OWNER_TELEGRAM_ID=your-numeric-telegram-user-id
