# Default: sqlite+aiosqlite:///./finapp.db
#DATABASE_URL=sqlite+aiosqlite:///./finapp.db

# Postgres remains a connection-string swap once asyncpg is installed.
#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finapp

# Set true when the app is served over HTTPS. Leave unset for localhost HTTP.
#COOKIE_SECURE=true
